# ==============================================================================
# 爬虫环境变量示例
#
# 复制为 .env 并填入真实值后，与 crawler/subscriptions.json 配合使用：
#     cp .env.example .env
#
# 注意：
#   1. .env 已被 gitignore，不会提交到仓库，请勿提交真实凭据。
#   2. 下列凭据均为运行爬虫所必需：缺失会导致对应平台登录 fatal 退出，
#      DEEPSEEK_API_KEY 缺失则跳过复盘报告生成（不阻断抓取）。
#   3. CI（GitHub Actions）中通过仓库 Secrets 注入同名变量，不走 .env。
# ==============================================================================

# ---- QOJ（https://qoj.ac）----
# 必需：QOJ 账号密码，用于登录抓取提交记录。
# CI Secret 名：QOJ_USERNAME / QOJ_PASSWORD
QOJ_USERNAME=
QOJ_PASSWORD=

# ---- HDU（https://acm.hdu.edu.cn）----
# 必需：HDU 账号密码，用于登录抓取提交记录。
# CI Secret 名：HDU_USERNAME / HDU_PASSWORD
HDU_USERNAME=
HDU_PASSWORD=

# ---- NowCoder（https://ac.nowcoder.com）----
# 必需：登录后浏览器 Cookie 中的 NOWCODERUID 与 t 两个字段。
#   获取方式：登录 ac.nowcoder.com → DevTools → Application → Cookies，
#   复制 NOWCODERUID 与 t 的值。Cookie 会过期，失效后需重新获取。
# CI Secret 名：NEWCODER_COOKIE_NOWCODERUID / NEWCODER_COOKIE_T
# （注意变量名中 NowCoder 拼写为 NEWCODER，为历史遗留，与代码保持一致）
NEWCODER_COOKIE_NOWCODERUID=
NEWCODER_COOKIE_T=

# ---- DeepSeek（复盘报告生成）----
# 可选（但建议填）：缺省时爬虫照常抓取，只是不生成 review.md 复盘报告。
# API Key 申请：https://platform.deepseek.com
# CI Secret 名：DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=

# ---- 仅供 GitHub Actions 使用，本地 .env 无需配置 ----
# CI 中由 browser-actions/setup-chrome 提供，base.py 仅在 GITHUB_ACTIONS
# 环境下读取；本地使用仓库内 crawler/chrome-linux64/chrome 与
# crawler/chromedriver-linux64/chromedriver 的相对路径，无需设置。
# CHROME_BINARY=
# CHROMEDRIVER_PATH=
