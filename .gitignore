# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 但保留 .env.example 作为模板提交
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# contest source
/public/contests

# build-time generated search index (scripts/generate-search-index.mjs)
/public/search-index.json

# python
.venv
__pycache__/

# crawler
# 开发分支忽略爬虫数据与增量状态；deploy 分支使用 .gitignore.deploy（CI 提交前
# 覆盖 .gitignore），将 contests/ 与状态文件纳入版本控制，保证增量同步生效。
/contests/
crawler/chrome-linux64
crawler/chromedriver-linux64
crawler/global.log.json
crawler/last-update.json
crawler/config.json
# 忽略 subscriptions 目录内容，但保留目录本身，使 ! 规则能重新纳入模板文件
# （直接忽略 crawler/subscriptions/ 会连目录一起忽略，git 不再进入目录，! 失效）
crawler/subscriptions/*
!crawler/subscriptions/subscriptions.example.json
crawler/prompt.template.md
crawler/qq-share.template.md
crawler/new-contests.json
crawler/*/contests.json
crawler/*/staged-submissions.json
crawler/*/log.json
crawler/*/input_*.json
crawler/server-task.log
# 但保留配置模板可提交
!crawler/config.example.json
!crawler/prompt.template.example.md
!crawler/qq-share.template.example.md

# test script
*test.sh
